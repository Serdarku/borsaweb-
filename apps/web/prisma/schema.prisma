generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PortfolioPosition {
  id        String   @id @default(cuid())
  owner     String
  symbol    String
  quantity  Float
  costBasis Float
  currency  String   @default("TRY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([owner])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  owner     String
  symbol    String
  createdAt DateTime @default(now())

  @@unique([owner, symbol])
  @@index([owner])
}
